#!/bin/zsh
set -euo pipefail

BIN="${0:A:h}"
REPO="${BIN:h:h:h:h}"
APP="$REPO/build/Build/Products/Debug/Bean.app"
RUN_ID="${BEAN_RUN_ID:-local}"
RUN_DIR="$REPO/artifacts/verify/$RUN_ID"
PIDFILE="$RUN_DIR/bean.pid"
mkdir -p "$RUN_DIR"

pid() { [[ -f "$PIDFILE" ]] && cat "$PIDFILE"; }
alive() { local p; p=$(pid) && kill -0 "$p" 2>/dev/null; }
window() { swift "$BIN/window.swift" "$(pid)"; }
frontmost() { osascript -e 'tell application "System Events" to get bundle identifier of first process whose frontmost is true'; }

input_ok() {
  [[ "$(cat "$HOME/Library/Caches/bean-verify.lock/owner" 2>/dev/null)" == "$RUN_DIR" ]] || { echo "refused: run $RUN_ID does not hold the notch lock, so it may not click or type. Run bean launch first." >&2; exit 3; }
  export BEAN_INPUT_OK=1
}

case "${1:-}" in
  tap|menubar|choose|fill|press|drag|dragout|regrab) input_ok ;;
esac

case "${1:-}" in
  build)
    cd "$REPO" && xcodegen generate --quiet
    xcodebuild -project "$REPO/Bean.xcodeproj" -scheme Bean -configuration Debug -derivedDataPath "$REPO/build" -destination 'platform=macOS,arch=arm64' -quiet build
    echo "built $APP"
    ;;
  launch)
    LOCK="$HOME/Library/Caches/bean-verify.lock"
    for _ in {1..120}; do
      mkdir "$LOCK" 2>/dev/null && { echo "$RUN_DIR" > "$LOCK/owner"; break; }
      [[ "$(cat "$LOCK/owner" 2>/dev/null)" == "$RUN_DIR" ]] && break
      echo "waiting for the notch: run $(cat "$LOCK/owner" 2>/dev/null) holds $LOCK" >&2; sleep 5
    done
    [[ "$(cat "$LOCK/owner" 2>/dev/null)" == "$RUN_DIR" ]] || { echo "gave up after 10 min waiting for $LOCK" >&2; exit 2; }
    others=$(pgrep -x Bean | grep -vx "$(pid || echo none)" | while read -r p; do ps -o args= -p "$p" | grep -q -e '--probe-' || echo "$p"; done || true)
    if [[ -n "$others" ]]; then
      echo "refusing: Bean already running as pid $others, not started by this run. Ask the user before quitting it." >&2; exit 2
    fi
    mkdir -p "$RUN_DIR/data"
    if [[ -n "${BEAN_LAUNCH_OPEN:-}" ]]; then
      open -n -g -a "$APP" --env BEAN_DATA_DIR="$RUN_DIR/data" ${BEAN_WINDOW_FILTER:+--env BEAN_WINDOW_FILTER="$BEAN_WINDOW_FILTER"} --stdout "$RUN_DIR/stdout.log" --stderr "$RUN_DIR/stdout.log"
      sleep 1
      pgrep -n -f "^$APP/Contents/MacOS/Bean" > "$PIDFILE"
    else
      BEAN_DATA_DIR="$RUN_DIR/data" "$APP/Contents/MacOS/Bean" > "$RUN_DIR/stdout.log" 2>&1 &
      echo $! > "$PIDFILE"
    fi
    for _ in {1..50}; do window >/dev/null 2>&1 && break; sleep 0.2; done
    window >/dev/null 2>&1 || { echo "no Bean window after 10s, see $RUN_DIR/stdout.log" >&2; exit 1; }
    echo "ready pid=$(pid) window=$(window) run=$RUN_DIR"
    ;;
  doctor)
    alive || { echo "FAIL: no live Bean started by run $RUN_ID"; exit 1; }
    exe=$(ps -o comm= -p "$(pid)")
    [[ "$exe" == "$APP/Contents/MacOS/Bean" ]] || { echo "FAIL: pid runs $exe"; exit 1; }
    read x y w h layer <<< "$(window)"
    echo "OK pid=$(pid) built=$(stat -f %Sm "$APP/Contents/MacOS/Bean") window=${x},${y} ${w}x${h} layer=$layer"
    ;;
  window) window ;;
  frontmost) frontmost ;;
  tap)
    read x y w h _ <<< "$(window)"
    swift "$BIN/click.swift" $((x + w - 24)) $((y + (h < 32 ? h : 32) / 2))
    sleep 0.8
    echo "window=$(window)"
    ;;
  menubar|popover)
    bounds=$(swift "$BIN/statusitem.swift" "$(pid)" $([[ "$1" == popover ]] && echo peek))
    echo "popover=$bounds"
    if [[ -n "${2:-}" && "$bounds" != closed ]]; then
      read x y w h <<< "$bounds"
      screencapture -x -R "$((x - 20)),0,$((w + 40)),$((y + h + 20))" "$RUN_DIR/$2.png"
      echo "$RUN_DIR/$2.png"
    fi
    ;;
  shot)
    name="${2:?usage: bean shot <name>}"
    read x y w h _ <<< "$(window)"
    screencapture -x -R "$((x - 40)),0,$((w + 80)),$((y + h + 20))" "$RUN_DIR/$name.png"
    echo "$RUN_DIR/$name.png"
    ;;
  choose)
    swift "$BIN/choose.swift" "$(pid)" "${2:?usage: bean choose <current value> <item>}" "${3:?usage: bean choose <current value> <item>}"
    ;;
  fill)
    swift "$BIN/fill.swift" "$(pid)" "${2:?usage: bean fill <text>}"
    ;;
  press)
    swift "$BIN/press.swift" "$(pid)" "${2:?usage: bean press <button label>}"
    sleep 0.8
    echo "window=$(window)"
    ;;
  agent)
    name="${2:?usage: bean agent <name> [hue] [accessory] (before launch)}"
    id=$(uuidgen)
    mkdir -p "$RUN_DIR/data/Agents/$id"
    printf '{"connectors":[],"createdAt":"%s","id":"%s","look":{"accessory":"%s","hue":%s},"name":"%s","personality":"test","role":"test"}\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "${4:-none}" "${3:-0.55}" "$name" > "$RUN_DIR/data/Agents/$id/agent.json"
    echo "agent $name $id"
    ;;
  find) swift "$BIN/find.swift" "$(pid)" "${2:?usage: bean find <accessibility id>}" ;;
  head) swift "$BIN/find.swift" "$(pid)" "agent-head-${2:?usage: bean head <agent name>}" ;;
  perch) swift "$BIN/find.swift" "$(pid)" "agent-perch-${2:?usage: bean perch <agent name>}" ;;
  target) swift "$BIN/target.swift" "${2:?usage: bean target <app name>}" ;;
  drag) swift "$BIN/drag.swift" "${@:2}" ;;
  dragout)
    read hx hy hw hh <<< "$(swift "$BIN/find.swift" "$(pid)" "agent-head-${2:?usage: bean dragout <agent> <app>|home}")"
    if [[ "${3:?}" == home ]]; then read tx ty <<< "$(window | awk '{print $1+$3/2, $2+$4/2}')"
    else read _ wx wy ww _ <<< "$(swift "$BIN/target.swift" "$3")"; tx=$((wx + ww * 2 / 3)); ty=$((wy + 80)); fi
    swift "$BIN/drag.swift" $((hx + hw / 2)) $((hy + hh / 2)) "$tx" "$ty" "${4:-1.4}"
    tail -n 3 "$RUN_DIR/data/creatures.jsonl" 2>/dev/null
    ;;
  regrab)
    read px py pw ph <<< "$(swift "$BIN/find.swift" "$(pid)" "agent-perch-${2:?usage: bean regrab <agent> <app>|home}")"
    if [[ "${3:?}" == home ]]; then read tx ty <<< "$(window | awk '{print $1+$3/2, $2+$4/2}')"
    else read _ wx wy ww _ <<< "$(swift "$BIN/target.swift" "$3")"; tx=$((wx + ww / 3)); ty=$((wy + 80)); fi
    swift "$BIN/drag.swift" $((px + pw / 2)) $((py + ph / 2)) "$tx" "$ty" "${4:-1.4}"
    tail -n 3 "$RUN_DIR/data/creatures.jsonl" 2>/dev/null
    ;;
  events) cat "$RUN_DIR/data/creatures.jsonl" 2>/dev/null ;;
  cpu)
    secs="${2:-20}"
    top -l $((secs + 1)) -s 1 -pid "$(pid)" -stats pid,cpu | awk -v p="$(pid)" '$1==p {n++; if (n>1) {s+=$2}} END {printf "cpu avg %.2f%% over %d s\n", s/(n-1), n-1}'
    ;;
  agents)
    shift
    mkdir -p "$RUN_DIR/data"
    BEAN_DATA_DIR="$RUN_DIR/data" "$APP/Contents/MacOS/Bean" --probe-agents "$@"
    ;;
  fixture)
    file="${3:?usage: bean fixture <title> <text-file>}"
    log="$RUN_DIR/fixture-${2//[^A-Za-z0-9]/_}.log"
    swift "$BIN/fixture-window.swift" "${2:?usage: bean fixture <title> <text-file> [onscreen [x y w h]]}" "$file" "${@:4}" > "$log" 2>&1 &
    for _ in {1..40}; do grep -q '^fixture pid=' "$log" 2>/dev/null && break; sleep 0.5; done
    head -1 "$log"
    ;;
  cleanup)
    for log in "$RUN_DIR"/fixture-*.log(N); do
      fp=$(grep -o 'pid=[0-9]*' "$log" | head -1 | cut -d= -f2)
      [[ -n "$fp" ]] && kill "$fp" 2>/dev/null && echo "stopped fixture $fp"
    done
    if alive; then
      kill "$(pid)"; for _ in {1..15}; do alive || break; sleep 0.2; done
      alive && kill -9 "$(pid)"
      echo "stopped pid $(pid)"
    fi
    rm -f "$PIDFILE"
    LOCK="$HOME/Library/Caches/bean-verify.lock"
    [[ "$(cat "$LOCK/owner" 2>/dev/null)" == "$RUN_DIR" ]] && rm -rf "$LOCK" && echo "released the notch lock"
    echo "evidence kept in $RUN_DIR"
    ;;
  *)
    echo "usage: bean build|launch|doctor|window|frontmost|tap|agent <name> [hue] [accessory]|head <agent>|perch <agent>|find <id>|target <app>|drag x1 y1 x2 y2 [s]|dragout <agent> <app>|home|regrab <agent> <app>|home|events|cpu [s]|menubar [shot-name]|popover [shot-name]|shot <name>|press <label>|choose <current> <item>|fill <text>|agents propose|agents create <request>|agents read <agent-id> <pid> [seconds]|fixture <title> <text-file>|cleanup" >&2; exit 64 ;;
esac
