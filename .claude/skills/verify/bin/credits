#!/usr/bin/env python3
import json, os, datetime
path = os.path.expanduser("~/Library/Application Support/Bean/ledger.jsonl")
grant = 150.0
rows = []
if os.path.exists(path):
    rows = [json.loads(line) for line in open(path) if line.strip()]
today = datetime.date.today().isoformat()
spent = sum(r["usd"] for r in rows)
day = sum(r["usd"] for r in rows if datetime.datetime.fromisoformat(r["at"].replace("Z", "+00:00")).astimezone().date().isoformat() == today)
start = rows[0]["at"] if rows else "no call yet"
print(f"ESTIMATE ${grant - spent:.2f} left of ${grant:.0f}: ${spent:.4f} logged since {start}, ${day:.4f} today, {len(rows)} calls. Calls before the ledger are not counted. The Meta API has no balance endpoint: the real balance is in the console at dev.meta.ai.")
