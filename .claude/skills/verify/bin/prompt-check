#!/usr/bin/env python3
"""Renders every prompt Bean sends against a fake model, with no paid call, and checks what must stay stable.

prompt-check [--save <folder>]   hashes per call, the free prefix rules, the refusal table and the defects.
"""
import argparse, hashlib, json, os, re, shutil, subprocess, sys, tempfile
from pathlib import Path

BIN = Path(__file__).resolve().parent
REPO = BIN.parents[3]
APP = REPO / "build/Build/Products/Debug/Bean.app/Contents/MacOS/Bean"
EVALS = REPO / "evals"
LABELS = ["agent-a", "agent-b", "agent-window", "bean-understand", "bean-work", "chat-agent", "chat-bean", "maker"]
MONEY = re.compile(r"budget|spent today|credits|\$\d|\bcost")
sha = lambda text: hashlib.sha256(text.encode()).hexdigest()[:12]


def content(message):
    text = message.get("content", "")
    return text if isinstance(text, str) else json.dumps(text)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--save", type=Path, help="write each rendered prompt there")
    args = parser.parse_args()
    root = Path(tempfile.mkdtemp(prefix="prompt-check-"))
    log = root / "requests.jsonl"
    server = subprocess.Popen([sys.executable, "-I", str(BIN / "fake-model.py"), str(log), "0.3"], stdout=subprocess.PIPE, text=True)
    port = server.stdout.readline().strip()
    env = {k: v for k, v in os.environ.items() if not k.startswith("BEAN_")}
    env |= {"BEAN_DATA_DIR": str(root / "data"), "BEAN_BASE_URL": f"http://127.0.0.1:{port}", "BEAN_IGNORE_ENV_FILE": "1", "BEAN_RUN_ID": "prompt-check",
            "BEAN_WINDOW_FILTER": "zz-none", "BEAN_OFF_LIMITS": "bank,topsecret", "BEAN_PROVIDER": "meta", "MODEL_API_KEY": "fake", "BEAN_DECIDER": "muse"}
    probe = lambda *a: subprocess.run([str(APP), "--probe-agents", *a], env=env, capture_output=True, text=True, timeout=120)
    calls = {}
    failed = []
    try:
        (root / "data").mkdir()
        made = probe("prompts", "setup")
        if made.returncode != 0:
            sys.exit(f"setup failed: {made.stdout[-400:]}{made.stderr[-400:]}")
        for label in LABELS:
            log.write_text("")
            run = probe("prompts", label)
            if run.returncode != 0:
                failed.append(f"{label}: probe exit {run.returncode}: {run.stdout[-300:]}")
            calls[label] = [json.loads(line) for line in log.read_text().splitlines()]
        print(f"{'call':<18} {'system':<13} {'tools':<13} {'sys chars':>9} {'msg chars':>9}  tool names")
        systems, tools = {}, {}
        for label, rows in calls.items():
            for row in rows[:1]:
                system = content(row["messages"][0])
                first = content(row["messages"][1]) if len(row["messages"]) > 1 else ""
                names = [t["function"]["name"] for t in row.get("tools", [])]
                shape = json.dumps(row.get("tools", []), sort_keys=True)
                systems[label], tools[label] = system, shape
                print(f"{label:<18} {sha(system):<13} {sha(shape) if names else '-':<13} {len(system):>9} {len(first):>9}  {','.join(names)[:90]}")
                if args.save:
                    args.save.mkdir(parents=True, exist_ok=True)
                    (args.save / f"{label}.system.txt").write_text(system)
                    (args.save / f"{label}.first.txt").write_text(first)
                    (args.save / f"{label}.tools.txt").write_text("\n".join(names) + "\n")
                    (args.save / f"{label}.tools.json").write_text(json.dumps(row.get("tools", []), indent=1, sort_keys=True))
            if not rows:
                failed.append(f"{label}: no model call was made")
        checks = [("one system for all agents", len({systems.get(k) for k in ["agent-a", "agent-b", "agent-window"]}) == 1),
                  ("Bean's understanding is shorter than its work", len(systems.get("bean-understand", "")) < len(systems.get("bean-work", ""))),
                  ("same tools for agents of one kind", tools.get("agent-a") == tools.get("agent-b"))]
        for name, ok in checks:
            print(f"{'ok  ' if ok else 'FAIL'} {name}")
        lost = [line for line in (EVALS / "rules.txt").read_text().splitlines() if not line.startswith("#") and any(line.split("|")[1] not in systems.get(k, "") for k in {"all": ["agent-a", "bean-work"], "agent": ["agent-a"], "bean": ["bean-work"], "understand": ["bean-understand"]}[line.split("|")[0]])]
        print(f"{'ok  ' if not lost else 'FAIL'} tuned rules kept: {len(lost)} lost")
        for line in lost:
            print("     ", line)
        everything = " ".join(systems.values()).lower()
        firsts = " ".join(content(r["messages"][1]) for rows in calls.values() for r in rows[:1] if len(r["messages"]) > 1).lower()
        hits = sorted(set(MONEY.findall(everything + " " + firsts)))
        print(f"{'ok  ' if not hits else 'FAIL'} no money word in a prompt: {hits}")
        for line in probe("defects").stdout.splitlines():
            if line.startswith(("defect", "check")):
                print(line)
            if line.startswith("check FAIL"):
                failed.append(line)
        cases = EVALS / "refusals.json"
        if cases.exists():
            result = probe("refusals", str(cases))
            found = json.loads(result.stdout[result.stdout.index("["):])
            saved = EVALS / "refusals-baseline.json"
            if args.save:
                (args.save / "refusals.json").write_text(json.dumps(found, indent=1, ensure_ascii=False) + "\n")
            if saved.exists():
                base = {c["id"]: c["refusal"] for c in json.loads(saved.read_text())}
                intended = {c["id"]: c for c in json.loads(cases.read_text()) if "intended" in c}
                wrong = [(c["id"], base.get(c["id"], "<new>"), c["refusal"]) for c in found if base.get(c["id"], "<new>") != c["refusal"] and (intended.get(c["id"], {}).get("intended", "<none>") != c["refusal"])]
                changed = [c["id"] for c in found if base.get(c["id"]) != c["refusal"]]
                print(f"{'ok  ' if not wrong else 'FAIL'} refusal table: {len(found)} cases, {len(changed)} changed as intended{'' if not changed else ': ' + ', '.join(changed)}")
                for item in wrong:
                    print("     ", item)
        for line in failed:
            print("FAIL", line)
    finally:
        server.terminate()
        shutil.rmtree(root, ignore_errors=True)
    sys.exit(1 if failed else 0)


main()
