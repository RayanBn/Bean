[
  {
    "id": "calls",
    "title": "Calls",
    "sentence": "Knows when a call starts and ends, and in which app. It hears nothing.",
    "driver": "audioActivity",
    "level": "signal",
    "beanHolds": true,
    "settle": 0,
    "dedupe": "{type}|{pid}",
    "emits": {
      "call.started": { "summary": "A call started in {app}", "whenNoModel": 1 },
      "call.ended": { "summary": "A call ended in {app}", "whenNoModel": 0 }
    }
  },
  {
    "id": "windows",
    "title": "Windows",
    "sentence": "Sees which apps and windows open, close and change, and which one you are in. It reads nothing inside a window with no agent.",
    "driver": "windowActivity",
    "level": "read",
    "beanHolds": true,
    "settle": 2,
    "repeatWindow": 60,
    "dedupe": "{type}|{where}",
    "emits": {
      "app.opened": { "summary": "{place} was opened", "whenNoModel": 0, "contentless": true },
      "app.closed": { "summary": "{place} was closed", "whenNoModel": 0, "contentless": true },
      "app.switched": { "summary": "The user switched to {place}", "whenNoModel": 0, "contentless": true },
      "window.opened": { "summary": "A window opened: {place}{number}" },
      "window.closed": { "summary": "A window closed: {place}" },
      "window.changed": { "summary": "The window title changed: {place}{number}" },
      "window.focused": { "summary": "You are in {place}", "logOnly": true },
      "window.unfocused": { "summary": "No window in front", "logOnly": true },
      "window.content": { "summary": "Content changed in {place}{number}", "onAgentWindow": 0.8 }
    }
  },
  {
    "id": "service",
    "title": "A connected service",
    "sentence": "Checks a connected service on a schedule with a read tool and notices when the answer changes. What changed can reach the model.",
    "driver": "connector",
    "level": "read",
    "perSubscription": true,
    "params": {
      "tool": "A read tool of a connected connector, by its full name, such as <server>__<read tool>.",
      "args": "Optional. The tool's arguments as a JSON object.",
      "every": "Optional. Seconds between checks, at least 60. 300 if you leave it out."
    },
    "settle": 0,
    "dedupe": "{type}|{title}",
    "emits": {
      "service.changed": { "summary": "{title} changed", "whenNoModel": 0.9 }
    }
  }
]
